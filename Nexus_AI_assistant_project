def send_scheduled_whatsapp(
    account_sid,
    auth_token,
    whatsapp_from,
    recipient_whatsapp,
    content_sid,
    content_variables
):
    try:
        if not whatsapp_from.startswith("whatsapp:"):
            whatsapp_from = f"whatsapp:{whatsapp_from}"

        if not recipient_whatsapp.startswith("whatsapp:"):
            recipient_whatsapp = f"whatsapp:{recipient_whatsapp}"

        twilio_client = Client(account_sid, auth_token)

        # Twilio Trial requires an approved Content Template.
        message = twilio_client.messages.create(
            from_=whatsapp_from,
            to=recipient_whatsapp,
            content_sid=content_sid,
            content_variables=json.dumps(content_variables)
        )

        print(
            f"[SUCCESS] WhatsApp template message sent to "
            f"{recipient_whatsapp}. Message SID: {message.sid}"
        )

    except Exception as e:
        print(f"[ERROR] Failed to send WhatsApp message: {e}")


