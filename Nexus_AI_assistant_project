def listen_user():

    r = sr.Recognizer()

    try:

        with sr.Microphone() as source:

            st.toast(
                "🎤 ऐकत आहे... बोला!",
                icon="🎙️"
            )

            audio = r.listen(
                source,
                timeout=5
            )

            return r.recognize_google(
                audio,
                language="mr-IN"
            )

    except Exception:

        return None


